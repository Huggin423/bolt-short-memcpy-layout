new file mode 100644
--- /dev/null
+++ b/bolt/utils/bolt_safe_layout.py
@@ -0,0 +1,204 @@
+# SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
+"""Generate a BOLT candidate and admit it only after an ELF layout audit."""
+import argparse
+import hashlib
+import json
+import re
+import shutil
+import struct
+import subprocess
+from dataclasses import dataclass
+from pathlib import Path
+
+from elfaudit import read as audit_elf
+
+
+@dataclass(frozen=True)
+class Instruction:
+    address: int
+    opcode: str
+    operands: str
+
+
+def instructions(binary, symbol):
+    code = subprocess.check_output(
+        ['objdump', '-d', '--no-show-raw-insn', f'--disassemble={symbol}', binary],
+        text=True)
+    items = re.findall(r'^[ \t]*([0-9a-f]+):[ \t]+([a-z][a-z0-9.]*)[ \t]*(.*)$',
+                       code, re.M)
+    return [Instruction(int(address, 16), opcode, operands)
+            for address, opcode, operands in items], code
+
+
+def tail_index(code):
+    tails = [i for i, inst in enumerate(code)
+             if inst.opcode == 'jmp' and re.search(r'<memcpy@(?:plt|GLIBC[^>]*)>', inst.operands)]
+    return tails[0] if len(tails) == 1 and tails[0] + 1 < len(code) else None
+
+
+def reference_path(code):
+    tail = tail_index(code)
+    if tail is None:
+        return None
+    for index in range(tail - 1, 0, -1):
+        inst = code[index]
+        if inst.opcode.startswith('j') or inst.opcode.startswith('ret'):
+            if inst.opcode not in ('je', 'jz') or code[index - 1].opcode != 'test':
+                return None
+            return code[index + 1].address, code[tail].address, code[tail + 1].address
+    return None
+
+
+def candidate_path(code, sections):
+    tail = tail_index(code)
+    if tail is None or '.text.cold' not in sections:
+        return None
+    cold = sections['.text.cold']
+    for index in range(tail - 1, 0, -1):
+        inst = code[index]
+        if inst.opcode.startswith('j') or inst.opcode.startswith('ret'):
+            if inst.opcode not in ('jbe', 'jna') or code[index - 1].opcode != 'cmp':
+                return None
+            target = re.match(r'([0-9a-f]+)\s', inst.operands)
+            if not target or not cold['addr'] <= int(target[1], 16) < cold['addr'] + cold['size']:
+                return None
+            return code[index + 1].address, code[tail].address, code[tail + 1].address
+    return None
+
+
+def virtual_bytes(binary, start, end):
+    data = binary.read_bytes()
+    assert data[:6] == b'\x7fELF\x02\x01'
+    table, = struct.unpack_from('<Q', data, 32)
+    entry_size, count = struct.unpack_from('<HH', data, 54)
+    for entry in range(count):
+        kind, flags, offset, address, _, size, _, _ = struct.unpack_from(
+            '<IIQQQQQQ', data, table + entry * entry_size)
+        if kind == 1 and flags & 1 and address <= start <= end <= address + size:
+            return data[offset + start - address:offset + end - address]
+    raise ValueError('the long path is not in one executable segment')
+
+
+def hot_symbols(sections, names, changed):
+    text = sections['.text']
+    end = text['addr'] + text['size']
+    return {name: (symbol['addr'], symbol['size'])
+            for name, symbol in names.items()
+            if name != changed and text['addr'] <= symbol['addr'] < end}
+
+
+def digest(path):
+    return hashlib.sha256(path.read_bytes()).hexdigest()
+
+
+def run(args):
+    out = args.directory.resolve()
+    out.mkdir(parents=True, exist_ok=False)
+    order = out / 'reference.order'
+    base = out / 'off'
+    final = out / 'selected'
+    common = ['--strict', '--reorder-blocks=ext-tsp', '--reorder-functions=cdsort',
+              '--split-functions', '--split-all-cold', '--plt=all', '--verify-cfg',
+              '--thread-count=1', '--enable-bat', '-v=1']
+    details = {'mode': 'off', 'input_sha256': digest(args.input),
+               'profile_sha256': digest(args.length_profile), 'runs': {}}
+
+    def generate(name, flags, *, ordered=False):
+        binary = out / name
+        options = common.copy()
+        if ordered:
+            options[options.index('--reorder-functions=cdsort')] = '--reorder-functions=user'
+            options.append(f'--function-order={order}')
+        command = [str(args.bolt), str(args.input), f'-data={args.data}',
+                   '-o', str(binary), *options, *flags]
+        log = out / (name + '.bolt.log')
+        with log.open('w') as file:
+            process = subprocess.run(command, stdout=file, stderr=subprocess.STDOUT)
+        details['runs'][name] = {'command': command, 'exit_code': process.returncode}
+        return binary if process.returncode == 0 else None, log.read_text()
+
+    def finish(binary, reason):
+        shutil.copy2(binary, final)
+        details['reason'] = reason
+        details['outputs'] = {'off': digest(base), 'selected': digest(final)}
+        (out / 'plan.json').write_text(json.dumps(details, indent=2) + '\n')
+        print(details['mode'], reason, flush=True)
+
+    generated, _ = generate('off', [f'--generate-function-order={order}'])
+    if not generated:
+        raise RuntimeError('BOLT failed to generate the off baseline')
+    optimize = [f'--memcpy-short-profile={args.length_profile}',
+                '--memcpy-reuse-length-branch', '--memcpy-reuse-long-fallthrough',
+                '--layout-probe-outline-reused-short']
+    draft, messages = generate('discovery', optimize, ordered=True)
+    if not draft:
+        return finish(base, 'BOLT rejected the discovery build')
+    matches = re.findall(r'^BOLT-INFO: reused memcpy length branch in (\S+) at (0x[0-9a-f]+)',
+                         messages, re.M)
+    details['matches'] = matches
+    if len(matches) != 1:
+        return finish(base, 'this implementation requires one unambiguous eligible function')
+    symbol, site = matches[0]
+    if not re.fullmatch(r'[A-Za-z0-9_.$-]+', symbol):
+        return finish(base, 'function name cannot be represented unambiguously by the layout options')
+    off_sections, off_symbols = audit_elf(base)
+    off_code, off_asm = instructions(base, symbol)
+    (out / 'off.asm').write_text(off_asm)
+    off_path = reference_path(off_code)
+    if not off_path or symbol not in off_symbols or '.text' not in off_sections:
+        return finish(base, 'the reference libc path could not be located unambiguously')
+
+    relax = [*optimize, f'--layout-probe-relax-alignment={symbol}']
+    probe, messages = generate('unpadded', relax, ordered=True)
+    if not probe:
+        return finish(base, 'BOLT rejected the unpadded layout')
+    probe_sections, _ = audit_elf(probe)
+    probe_code, _ = instructions(probe, symbol)
+    probe_path = candidate_path(probe_code, probe_sections)
+    if not probe_path or probe_path[2] - probe_path[0] != off_path[2] - off_path[0]:
+        return finish(base, 'the long path is not contiguous or its encoded size changed')
+    pad = off_path[1] - probe_path[1]
+    details['inferred_padding'] = pad
+    if not 0 <= pad <= args.padding_budget:
+        return finish(base, 'the layout requires more placement space than the configured budget')
+
+    candidate_flags = [*relax, f'--pad-funcs-before={symbol}:{pad}'] if pad else relax
+    candidate, messages = generate('candidate', candidate_flags, ordered=True)
+    if not candidate:
+        return finish(base, 'BOLT rejected the calculated placement')
+    final_matches = re.findall(
+        r'^BOLT-INFO: reused memcpy length branch in (\S+) at (0x[0-9a-f]+)',
+        messages, re.M)
+    if final_matches != [(symbol, site)]:
+        return finish(base, 'the final build did not reproduce the discovered match')
+    sections, names = audit_elf(candidate)
+    if '.text' not in sections:
+        return finish(base, 'the candidate has no auditable main text section')
+    code, assembly = instructions(candidate, symbol)
+    (out / 'candidate.asm').write_text(assembly)
+    path = candidate_path(code, sections)
+    checks = {
+        'long_start_tail_and_end_match': path == off_path,
+        'long_machine_code_matches': bool(path and path == off_path
+            and virtual_bytes(base, off_path[0], off_path[2]) ==
+            virtual_bytes(candidate, path[0], path[2])),
+        'other_hot_function_addresses_and_sizes_match':
+            hot_symbols(off_sections, off_symbols, symbol) == hot_symbols(sections, names, symbol),
+        'main_text_address_and_size_match':
+            tuple(off_sections['.text'][k] for k in ('addr', 'size')) ==
+            tuple(sections['.text'][k] for k in ('addr', 'size')),
+    }
+    details['layout_checks'] = checks
+    details['long_path'] = {'reference': off_path, 'candidate': path}
+    if not all(checks.values()):
+        return finish(base, 'the emitted layout failed the address or code audit')
+    details['mode'] = 'optimized'
+    finish(candidate, 'the emitted layout passed all checks')
+
+
+if __name__ == '__main__':
+    parser = argparse.ArgumentParser(description=__doc__)
+    for name in ('bolt', 'input', 'data', 'length-profile', 'directory'):
+        parser.add_argument(f'--{name}', type=lambda path: Path(path).resolve(), required=True)
+    parser.add_argument('--padding-budget', type=int, default=64)
+    run(parser.parse_args())
