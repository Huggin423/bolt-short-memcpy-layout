+static cl::opt<bool> MemcpyReuseLongFallthrough(
+    "memcpy-reuse-long-fallthrough",
+    cl::desc("Keep the original libc path next to a reused length guard"),
+    cl::cat(opts::BoltOptCategory));
+constexpr StringLiteral MemcpyReuseAnchor = "MemcpyReuseAnchor";
+
+bool placeMemcpyLongFallthrough(BinaryFunction &BF) {
+  FunctionLayout &Layout = BF.getLayout();
+  MCPlusBuilder &MIB = *BF.getBinaryContext().MIB;
+  for (BinaryBasicBlock *Head : Layout.blocks()) {
+    if (!llvm::any_of(*Head, [&](const MCInst &Inst) {
+          return MIB.hasAnnotation(Inst, MemcpyReuseAnchor);
+        }))
+      continue;
+    const auto Branch = Head->getLastNonPseudo();
+    if (Branch == Head->rend() || !MIB.isConditionalBranch(*Branch) ||
+        MIB.getCondCode(*Branch) != 7) // x86 unsigned above
+      return false;
+    BinaryBasicBlock *Long = Head->getConditionalSuccessor(true);
+    if (!Long || Long->getFragmentNum() != Head->getFragmentNum())
+      return false;
+    SmallVector<BinaryBasicBlock *, 0> Order(Layout.block_begin(),
+                                             Layout.block_end());
+    auto Position = llvm::find(Order, Long);
+    if (Position == Order.end())
+      return false;
+    Order.erase(Position);
+    Order.insert(std::next(llvm::find(Order, Head)), Long);
+    return Layout.update(Order);
+  }
+  return false;
+}
