+constexpr unsigned ShortMemcpyLimit = 16;
+constexpr uint64_t MinMemcpySamples = 10000;
+
+struct MemcpyLengthProfile {
+  uint64_t Total = 0;
+  uint64_t Short = 0;
+  std::array<uint64_t, ShortMemcpyLimit + 1> Lengths{};
+};
+
+Expected<DenseMap<uint64_t, MemcpyLengthProfile>>
+readMemcpyTailProfile(StringRef Path, StringRef InputFile) {
+  auto Buffer = MemoryBuffer::getFile(Path, /*IsText=*/true);
+  if (!Buffer)
+    return createFileError(Path, Buffer.getError());
+  line_iterator Line(**Buffer, /*SkipBlanks=*/true, '#');
+  if (Line == line_iterator())
+    return createStringError(inconvertibleErrorCode(), "empty memcpy profile");
+
+  SmallVector<StringRef, 20> Fields;
+  SplitString(*Line, Fields);
+  if (Fields.size() != 2 || Fields[0] != "bolt-memcpy-profile-v1")
+    return createStringError(inconvertibleErrorCode(),
+                             "invalid memcpy profile header");
+
+  auto Input = MemoryBuffer::getFile(InputFile);
+  if (!Input)
+    return createFileError(InputFile, Input.getError());
+  const std::string Digest =
+      toHex(SHA256::hash(arrayRefFromStringRef((*Input)->getBuffer())));
+  if (!Fields[1].equals_insensitive(Digest))
+    return createStringError(inconvertibleErrorCode(),
+                             "memcpy profile SHA-256 does not match input ELF");
+
+  DenseMap<uint64_t, MemcpyLengthProfile> Profile;
+  for (++Line; Line != line_iterator(); ++Line) {
+    Fields.clear();
+    SplitString(*Line, Fields);
+    uint64_t Address;
+    MemcpyLengthProfile Site;
+    auto InvalidRecord = [&] {
+      return createStringError(inconvertibleErrorCode(),
+                               "invalid memcpy profile record at line %u",
+                               static_cast<unsigned>(Line.line_number()));
+    };
+    if (Fields.size() != Site.Lengths.size() + 2 ||
+        Fields[0].getAsInteger(16, Address) ||
+        Fields[1].getAsInteger(10, Site.Total) || !Site.Total)
+      return InvalidRecord();
+
+    for (auto [Field, Count] :
+         llvm::zip_equal(ArrayRef(Fields).drop_front(2), Site.Lengths)) {
+      if (Field.getAsInteger(10, Count) || Count > Site.Total - Site.Short)
+        return InvalidRecord();
+      Site.Short += Count;
+    }
+    if (!Profile.try_emplace(Address, Site).second)
+      return InvalidRecord();
+  }
+  return Profile;
+}
+
+struct MemcpyBucket {
+  unsigned First, Last, Width;
+};
+
+constexpr std::array<MemcpyBucket, 5> MemcpyBuckets = {
+    {{0, 0, 0}, {1, 1, 1}, {2, 3, 2}, {4, 7, 4}, {8, 16, 8}}};
+constexpr unsigned AllMemcpyBuckets = (1U << MemcpyBuckets.size()) - 1;
+
+using SizeCondition = MCPlusBuilder::MemcpySizeCondition;
+
+struct MemcpyDecision {
+  unsigned Bound = 0;
+  SizeCondition Condition = SizeCondition::Below;
+  unsigned Taken = 0;
+  unsigned Fallthrough = 0;
+};
+
+uint64_t scaleMemcpyCount(uint64_t Count, uint64_t Weight, uint64_t Total) {
+  if (!Total)
+    return 0;
+  return ((APInt(128, Count) * APInt(128, Weight)).udiv(Total)).getZExtValue();
+}
+
+void emitShortMemcpy(BinaryFunction &BF, BinaryBasicBlock &Short,
+                     int32_t CFIState, const MemcpyLengthProfile &Profile,
+                     unsigned Buckets) {
+  std::array<uint64_t, AllMemcpyBuckets + 1> Weights{};
+  for (unsigned I = 0; I < MemcpyBuckets.size(); ++I) {
+    const auto &B = MemcpyBuckets[I];
+    Weights[1U << I] =
+        std::accumulate(Profile.Lengths.begin() + B.First,
+                        Profile.Lengths.begin() + B.Last + 1, uint64_t(0));
+  }
+  std::array<MemcpyDecision, AllMemcpyBuckets + 1> Decisions{};
+  std::array<long double, AllMemcpyBuckets + 1> Costs{};
+  // Each proper subset has a smaller mask, so its best cost is ready.
+  for (unsigned Mask = 1; Mask <= AllMemcpyBuckets; ++Mask) {
+    if (llvm::isPowerOf2_32(Mask))
+      continue;
+    const unsigned First = Mask & (~Mask + 1);
+    Weights[Mask] = Weights[First] + Weights[Mask ^ First];
+    Costs[Mask] = std::numeric_limits<long double>::infinity();
+    for (unsigned I = 0; I < MemcpyBuckets.size() + 1; ++I) {
+      const bool Equal = I >= MemcpyBuckets.size() - 1;
+      const unsigned Bound = Equal ? I - (MemcpyBuckets.size() - 1)
+                                   : MemcpyBuckets[I + 1].First;
+      const unsigned Candidate = Equal ? 1U << Bound : (1U << (I + 1)) - 1;
+      const unsigned Taken = Mask & Candidate;
+      const unsigned Fallthrough = Mask ^ Taken;
+      if (!Taken || !Fallthrough)
+        continue;
+      const long double Cost = static_cast<long double>(Weights[Mask]) +
+                               Costs[Taken] + Costs[Fallthrough];
+      if (Cost < Costs[Mask]) {
+        Costs[Mask] = Cost;
+        Decisions[Mask] = {Bound,
+                           Equal ? SizeCondition::Equal : SizeCondition::Below,
+                           Taken, Fallthrough};
+      }
+    }
+  }
+
+  BinaryContext &BC = BF.getBinaryContext();
+  MCPlusBuilder &MIB = *BC.MIB;
+  auto NewBlock = [&] {
+    BinaryBasicBlock *BB = BF.addBasicBlock();
+    BB->setOffset(Short.getInputOffset());
+    BB->setCFIState(CFIState);
+    return BB;
+  };
+  auto Emit = [&](auto &&Self, BinaryBasicBlock &BB, unsigned Mask) -> void {
+    if (llvm::isPowerOf2_32(Mask)) {
+      const unsigned Width = MemcpyBuckets[llvm::countr_zero(Mask)].Width;
+      BB.addInstructions(MIB.createShortMemcpy(Width));
+      MCInst Ret;
+      MIB.createReturn(Ret);
+      BB.addInstruction(std::move(Ret));
+      return;
+    }
+    const auto &Decision = Decisions[Mask];
+    BinaryBasicBlock *Taken = NewBlock();
+    BinaryBasicBlock *Fallthrough = NewBlock();
+    const uint64_t TakenCount = scaleMemcpyCount(
+        BB.getExecutionCount(), Weights[Decision.Taken], Weights[Mask]);
+    Taken->setExecutionCount(TakenCount);
+    Fallthrough->setExecutionCount(BB.getExecutionCount() - TakenCount);
+    BB.addInstructions(MIB.createMemcpySizeCheck(
+        Decision.Bound, Decision.Condition, Taken->getLabel(), BC.Ctx.get()));
+    BB.addSuccessor(Taken, Taken->getExecutionCount());
+    BB.addSuccessor(Fallthrough, Fallthrough->getExecutionCount());
+    Self(Self, *Taken, Decision.Taken);
+    Self(Self, *Fallthrough, Decision.Fallthrough);
+  };
+  Emit(Emit, Short, Buckets);
+}
+
+void specializeMemcpyTail(BinaryFunction &BF, BinaryBasicBlock &Head,
+                          BinaryBasicBlock::iterator Tail,
+                          const MemcpyLengthProfile &Profile) {
+  BinaryContext &BC = BF.getBinaryContext();
+  MCPlusBuilder &MIB = *BC.MIB;
+  BinaryBasicBlock *Short = Head.splitAt(Tail);
+  Short->eraseInstruction(Short->begin());
+  Short->setOffset(Head.getInputOffset());
+
+  auto NewBlock = [&] {
+    BinaryBasicBlock *BB = BF.addBasicBlock();
+    BB->setOffset(Head.getInputOffset());
+    BB->setCFIState(Short->getCFIState());
+    return BB;
+  };
+
+  BinaryBasicBlock *Long = NewBlock();
+  Long->addInstructions(MIB.createFullSizeMemcpy());
+  MCInst Ret;
+  MIB.createReturn(Ret);
+  Long->addInstruction(std::move(Ret));
+
+  // Keep the conditional target first in the CFG. Layout passes choose
+  // the actual fall-through and update the conditional branch as needed.
+  auto AddBranch = [&](BinaryBasicBlock &BB, unsigned Bound,
+                       SizeCondition Condition, BinaryBasicBlock &Taken,
+                       BinaryBasicBlock &Fallthrough) {
+    BB.addInstructions(MIB.createMemcpySizeCheck(Bound, Condition,
+                                                 Taken.getLabel(), BC.Ctx.get()));
+    BB.addSuccessor(&Taken, Taken.getExecutionCount());
+    BB.addSuccessor(&Fallthrough, Fallthrough.getExecutionCount());
+  };
+  const uint64_t Count = Head.getKnownExecutionCount();
+  Short->setExecutionCount(scaleMemcpyCount(Count, Profile.Short, Profile.Total));
+  Long->setExecutionCount(Count - Short->getExecutionCount());
+  Head.removeAllSuccessors();
+  AddBranch(Head, ShortMemcpyLimit, SizeCondition::Above, *Long, *Short);
+
+  emitShortMemcpy(BF, *Short, Short->getCFIState(), Profile,
+                  AllMemcpyBuckets);
+}
+
+static cl::opt<bool> ReuseMemcpyLengthBranch(
+    "memcpy-reuse-length-branch",
+    cl::desc("Reuse a proven zero-length branch for memcpy tail specialization"),
+    cl::cat(opts::BoltOptCategory));
+
+struct MemcpyLengthBranch {
+  BinaryBasicBlock *Head;
+  BinaryBasicBlock *Zero;
+  MCPhysReg Reg;
+};
+
+// This first implementation handles a straight-line copy block with one
+// predecessor. Walk backwards from memcpy's length argument, following only
+// full-width copies and accepting calls only across callee-saved registers.
+std::optional<MemcpyLengthBranch>
+findMemcpyLengthBranch(BinaryFunction &BF, BinaryBasicBlock &Long,
+                       BinaryBasicBlock::iterator Tail, RegAnalysis &RA) {
+  BinaryContext &BC = BF.getBinaryContext();
+  MCPlusBuilder &MIB = *BC.MIB;
+  if (BF.isMultiEntry() || BF.hasJumpTables() || BF.hasEHRanges() ||
+      BF.getLSDAAddress() || Long.pred_size() != 1 || Long.isEntryPoint() ||
+      Long.isLandingPad())
+    return std::nullopt;
+  BinaryBasicBlock *Head = *Long.pred_begin();
+  if (Head == &Long || Head->succ_size() != 2 || Head->size() < 2)
+    return std::nullopt;
+  auto Branch = std::prev(Head->end());
+  auto Test = std::prev(Branch);
+  if (!MIB.isConditionalBranch(*Branch) ||
+      BC.MII->getName(Test->getOpcode()) != "TEST64rr" ||
+      !Test->getOperand(0).isReg() || !Test->getOperand(1).isReg() ||
+      Test->getOperand(0).getReg() != Test->getOperand(1).getReg())
+    return std::nullopt;
+  // X86 condition encodings for equality and inequality.
+  constexpr unsigned Equal = 4, NotEqual = 5;
+  const unsigned Condition = MIB.getCondCode(*Branch);
+  if ((Condition != Equal && Condition != NotEqual) ||
+      Head->getConditionalSuccessor(Condition == NotEqual) != &Long)
+    return std::nullopt;
+  BinaryBasicBlock *Zero = Head->getConditionalSuccessor(Condition == Equal);
+  if (Zero == Head || Zero == &Long || Zero->pred_size() != 1 ||
+      Zero->isEntryPoint() || Zero->isLandingPad() ||
+      Zero->getFirstNonPseudo() == Zero->end())
+    return std::nullopt;
+  if (Head->getCFIStateAtExit() != Long.getCFIState() ||
+      Head->getCFIStateAtExit() != Zero->getCFIState())
+    return std::nullopt;
+
+  MCPhysReg Reg = MIB.getIntArgRegister(2);
+  BitVector Saved(BC.MRI->getNumRegs()), Clobbered(BC.MRI->getNumRegs());
+  MIB.getCalleeSavedRegs(Saved);
+  for (auto I = std::make_reverse_iterator(Tail); I != Long.rend(); ++I) {
+    if (MIB.isPseudo(*I))
+      continue;
+    if (MIB.isBranch(*I) || MIB.isReturn(*I) || MIB.isInvoke(*I))
+      return std::nullopt;
+    if (MIB.isCall(*I)) {
+      if (!MIB.getTargetSymbol(*I) || !Saved.test(Reg))
+        return std::nullopt;
+      continue;
+    }
+    Clobbered.reset();
+    MIB.getClobberedRegs(*I, Clobbered);
+    if (!Clobbered.anyCommon(MIB.getAliases(Reg)))
+      continue;
+    if (BC.MII->getName(I->getOpcode()) != "MOV64rr" ||
+        I->getOperand(0).getReg() != Reg)
+      return std::nullopt;
+    Reg = I->getOperand(1).getReg();
+  }
+  if (Reg != Test->getOperand(0).getReg())
+    return std::nullopt;
+  DataflowInfoManager Info(BF, &RA, nullptr);
+  auto &Liveness = Info.getLivenessAnalysis();
+  const MCPhysReg Flags = MIB.getFlagsReg();
+  if (Liveness.isAlive(&*Long.getFirstNonPseudo(), Flags) ||
+      Liveness.isAlive(&*Zero->getFirstNonPseudo(), Flags))
+    return std::nullopt;
+  return MemcpyLengthBranch{Head, Zero, Reg};
+}
+
+void reuseMemcpyLengthBranch(BinaryFunction &BF, BinaryBasicBlock &Long,
+                             BinaryBasicBlock::iterator Tail,
+                             MemcpyLengthBranch Match,
+                             const MemcpyLengthProfile &Profile) {
+  BinaryContext &BC = BF.getBinaryContext();
+  MCPlusBuilder &MIB = *BC.MIB;
+  BinaryBasicBlock &Head = *Match.Head;
+  BinaryBasicBlock &Zero = *Match.Zero;
+  const uint64_t NonzeroCount = Long.getKnownExecutionCount();
+  const uint64_t ZeroCount = Zero.getKnownExecutionCount();
+  const uint64_t ShortCount =
+      scaleMemcpyCount(NonzeroCount, Profile.Short - Profile.Lengths[0],
+                       Profile.Total - Profile.Lengths[0]);
+
+  BinaryBasicBlock &Dispatch = *BF.addBasicBlock();
+  Dispatch.setOffset(Zero.getInputOffset());
+  Dispatch.setCFIState(Zero.getCFIState());
+  Dispatch.setExecutionCount(ShortCount + ZeroCount);
+
+  BinaryBasicBlock &Prep = *BF.addBasicBlock();
+  Prep.setOffset(Long.getInputOffset());
+  Prep.setCFIState(Long.getCFIState());
+  Prep.setExecutionCount(ShortCount);
+  for (auto I = Long.begin(); I != Tail; ++I) {
+    MCInst Copy = *I;
+    // The duplicate has no unique original address for translation.
+    if (!MIB.isPseudo(Copy))
+      MIB.clearOffset(Copy);
+    Prep.addInstruction(std::move(Copy));
+  }
+  const int32_t CopyCFI = Long.getCFIStateAtInstr(&*Tail);
+
+  auto LongCheck = MIB.createMemcpySizeCheck(
+      ShortMemcpyLimit, SizeCondition::Above, Long.getLabel(), BC.Ctx.get());
+  LongCheck.front().getOperand(0).setReg(Match.Reg);
+  if (MemcpyReuseLongFallthrough)
+    MIB.addAnnotation(LongCheck.front(), MemcpyReuseAnchor, true);
+  Head.eraseInstruction(std::prev(Head.end()));
+  Head.eraseInstruction(std::prev(Head.end()));
+  Head.addInstructions(LongCheck);
+  Long.setExecutionCount(NonzeroCount - ShortCount);
+  Head.removeAllSuccessors();
+  Head.addSuccessor(&Long, Long.getExecutionCount());
+  Head.addSuccessor(&Dispatch, Dispatch.getExecutionCount());
+
+  Dispatch.addInstructions(
+      MIB.createCmpJE(Match.Reg, 0, Zero.getLabel(), BC.Ctx.get()));
+  Dispatch.addSuccessor(&Zero, ZeroCount);
+  Dispatch.addSuccessor(&Prep, ShortCount);
+  emitShortMemcpy(BF, Prep, CopyCFI, Profile, AllMemcpyBuckets & ~1U);
+  // Tag only the newly emitted dispatch and its short-copy tree.
+  MIB.addAnnotation(*Dispatch.getFirstNonPseudo(), "MemcpyReusedShort", true);
+  SmallVector<BinaryBasicBlock *, 8> ShortBlocks{&Prep};
+  while (!ShortBlocks.empty()) {
+    BinaryBasicBlock *BB = ShortBlocks.pop_back_val();
+    MIB.addAnnotation(*BB->getFirstNonPseudo(), "MemcpyReusedShort", true);
+    llvm::append_range(ShortBlocks, BB->successors());
+  }
+}
+
+
+} // namespace
+
+Error SpecializeMemcpyTails::runOnFunctions(BinaryContext &BC) {
+  if (!BC.isELF() || BC.TheTriple->getArch() != Triple::x86_64)
+    return createStringError(inconvertibleErrorCode(),
+                             "--memcpy-short-profile requires x86-64 ELF");
+
+  auto Profile = readMemcpyTailProfile(ProfilePath, BC.getFilename());
+  if (!Profile)
+    return Profile.takeError();
+
+  uint64_t NumSpecialized = 0;
+  MCPlusBuilder &MIB = *BC.MIB;
+  RegAnalysis RA(BC, nullptr, nullptr);
+  RA.setConservativeStrategy(RegAnalysis::ConservativeStrategy::CLOBBERS_ABI);
+  for (auto &BFI : BC.getBinaryFunctions()) {
+    BinaryFunction &BF = BFI.second;
+    if (!shouldOptimize(BF) || !BC.shouldEmit(BF))
+      continue;
+
+    // Rewriting adds blocks, so walk a snapshot of the original blocks.
+    SmallVector<BinaryBasicBlock *, 0> Blocks(BF.pbegin(), BF.pend());
+    for (BinaryBasicBlock *BB : Blocks) {
+      if (!BB->getKnownExecutionCount() || BB->succ_size())
+        continue;
+      auto Tail = BB->getLastNonPseudo();
+      if (Tail == BB->rend() || !MIB.isTailCall(*Tail) ||
+          MIB.getConditionalTailCall(*Tail) ||
+          MCPlus::getNumPrimeOperands(*Tail) != 1)
+        continue;
+      const MCSymbol *Callee = MIB.getTargetSymbol(*Tail);
+      if (!Callee || Callee->getName() != "memcpy@PLT")
+        continue;
+
+      auto Offset = MIB.getOffset(*Tail);
+      if (!Offset)
+        continue;
+      const uint64_t Address = BF.getAddress() + *Offset;
+      auto It = Profile->find(Address);
+      if (It == Profile->end())
+        continue;
+      const MemcpyLengthProfile &Site = It->second;
+      if (Site.Total < MinMemcpySamples ||
+          Site.Short < Site.Total - Site.Total / 10)
+        continue;
+
+      auto TailInst = std::prev(Tail.base());
+      if (ReuseMemcpyLengthBranch) {
+        auto Match = findMemcpyLengthBranch(BF, *BB, TailInst, RA);
+        if (!Match) {
+          if (opts::Verbosity)
+            BC.outs() << "BOLT-INFO: no reusable length branch in "
+                      << BF.getPrintName() << " at " << format_hex(Address, 0)
+                      << '\n';
+          continue;
+        }
+        reuseMemcpyLengthBranch(BF, *BB, TailInst, *Match, Site);
+        BC.outs() << "BOLT-INFO: reused memcpy length branch in "
+                  << BF.getPrintName() << " at " << format_hex(Address, 0)
+                  << '\n';
+        ++NumSpecialized;
+        // One transform per function keeps the copied region and the
+        // original matches independent.
+        break;
+      }
+      specializeMemcpyTail(BF, *BB, TailInst, Site);
+      ++NumSpecialized;
+      if (opts::Verbosity)
+        BC.outs() << "BOLT-INFO: specialized memcpy tail in "
+                  << BF.getPrintName() << " at " << format_hex(Address, 0)
+                  << " (" << Site.Short << '/' << Site.Total
+                  << " short copies)\n";
+    }
+  }
+  BC.outs() << "BOLT-INFO: specialized " << NumSpecialized
+            << " memcpy tail call sites using a length profile\n";
+  return Error::success();
+}
