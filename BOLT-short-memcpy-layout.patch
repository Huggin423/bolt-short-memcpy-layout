+++ b/bolt/utils/elfaudit.py
@@ -0,0 +1,21 @@
+# SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
+import struct,hashlib,json,sys
+from pathlib import Path
+def read(p):
+ b=Path(p).read_bytes();assert b[:6]==b'\x7fELF\x02\x01'
+ off=struct.unpack_from('<Q',b,40)[0];ents,namesidx=struct.unpack_from('<H',b,58)[0],struct.unpack_from('<H',b,62)[0];n=struct.unpack_from('<H',b,60)[0]
+ ss=[struct.unpack_from('<IIQQQQIIQQ',b,off+i*ents) for i in range(n)];t=ss[namesidx];names=b[t[4]:t[4]+t[5]]
+ out={};syms={}
+ for s in ss:
+  k=names[s[0]:].split(b'\0')[0].decode()
+  if s[2]&2:out[k]={'addr':s[3],'size':s[5],'sha':hashlib.sha256(b[s[4]:s[4]+s[5]] if s[1]!=8 else b'').hexdigest()}
+  if s[1]==2:
+   t=ss[s[6]];st=b[t[4]:t[4]+t[5]]
+   for j in range(s[4],s[4]+s[5],s[9]):
+    nm,info,other,idx,addr,size=struct.unpack_from('<IBBHQQ',b,j)
+    if info&15!=2 or not size or idx>=len(ss):continue
+    name=st[nm:].split(b'\0')[0].decode();sec=ss[idx];pos=sec[4]+addr-sec[3]
+    syms[name]={'addr':addr,'size':size,'sha':hashlib.sha256(b[pos:pos+size]).hexdigest()}
+ return out,syms
+if __name__=='__main__':
+ a,sa=read(sys.argv[1]);b,sb=read(sys.argv[2]);d={'alloc_equal':a==b,'different_sections':[k for k in a.keys()|b.keys() if a.get(k)!=b.get(k)],'functions':[{'name':k,'before':sa.get(k),'after':sb.get(k)} for k in sa.keys()|sb.keys() if sa.get(k)!=sb.get(k)]};print(json.dumps(d,indent=2))
